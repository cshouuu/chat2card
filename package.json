{
  "name": "chat2card",
  "private": true,
  "version": "1.0.0",
  "description": "Turn AI chat conversations (ChatGPT / Claude / etc.) into beautiful shareable cards and long images. 把 AI 对话一键变成精美分享卡片/长图。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:parser": "node parser-service/server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test parser-service/*.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
